graph LR

%% ─────────────────────────────────────────
%% CAPA CLIENTE
%% ─────────────────────────────────────────
    User(["👤 Usuario"])
    Frontend["🖥️ Frontend\nReact SPA"]

%% ─────────────────────────────────────────
%% PERÍMETRO DE SEGURIDAD
%% ─────────────────────────────────────────
    WAF["🛡️ WAF\nWeb Application Firewall\n(DDoS · SQL Injection · XSS)"]

%% ─────────────────────────────────────────
%% SUBRED PÚBLICA – CAPA DE ACCESO
%% ─────────────────────────────────────────
    subgraph PublicSubnet["🌐 Subred Pública"]
        direction LR
        GW["⚙️ API Gateway + BFF\n(Rate Limiting · Routing)"]
        Auth["🔐 Auth Service\nJWT Validation\n(RS256 · Expiry · Blacklist)"]
    end

%% ─────────────────────────────────────────
%% SUBRED PRIVADA – CAPA DE LÓGICA
%% ─────────────────────────────────────────
    subgraph PrivateSubnet["🔒 Subred Privada"]
        direction LR

        subgraph Orders["📦 MS Pedidos"]
            OrdersSvc["Orders Service"]
        end

        subgraph Inventory["🏭 MS Inventario"]
            InvSvc["Inventory Service"]
        end

        subgraph Shipping["🚚 MS Envíos"]
            ShipSvc["Shipping Service"]
            FM["🏗️ Factory Method\nStandardShipping\nExpressShipping\nSameDayShipping"]
            ShipSvc --> FM
        end

        CB(["⚡ Circuit Breaker\nClosed · Open · Half-Open"])
    end

%% ─────────────────────────────────────────
%% MESSAGE BROKER
%% ─────────────────────────────────────────
    subgraph Broker["📨 Message Broker – RabbitMQ"]
        E1[["pedido.creado"]]
        E2[["pago.confirmado"]]
        E3[["despacho.listo"]]
    end

%% ─────────────────────────────────────────
%% CAPA DE DATOS – REPOSITORIOS + DB
%% ─────────────────────────────────────────
    subgraph DataLayer["🗄️ Capa de Datos"]
        direction LR

        RepO["📁 Repository\nOrdersRepository"]
        RepI["📁 Repository\nInventoryRepository"]
        RepS["📁 Repository\nShippingRepository"]

        DBO[("🛢️ PostgreSQL\nschema: pedidos\n🔑 AES-256")]
        DBI[("🛢️ PostgreSQL\nschema: inventario\n🔑 AES-256")]
        DBS[("🛢️ PostgreSQL\nschema: envios\n🔑 AES-256")]
    end

%% ─────────────────────────────────────────
%% CONEXIONES PRINCIPALES
%% ─────────────────────────────────────────

    User        -->|"HTTPS/TLS"| Frontend
    Frontend    -->|"HTTPS/TLS"| WAF
    WAF         -->|"HTTPS/TLS"| GW
    GW          <-->|"Valida JWT"| Auth
    GW          -->|"HTTP interno"| OrdersSvc
    GW          -->|"HTTP interno"| InvSvc
    GW          -->|"HTTP interno"| ShipSvc

%% Circuit Breaker entre Pedidos e Inventario
    OrdersSvc   -->|"Consulta stock"| CB
    CB          -->|"Protegido"| InvSvc

%% Eventos asíncronos
    OrdersSvc   -->|"Publica"| E1
    E2          -->|"Consume"| OrdersSvc
    E1          -->|"Consume"| ShipSvc
    ShipSvc     -->|"Publica"| E3
    E3          -->|"Consume"| InvSvc

%% Repository Pattern → DB
    OrdersSvc   --> RepO --> DBO
    InvSvc      --> RepI --> DBI
    ShipSvc     --> RepS --> DBS

%% ─────────────────────────────────────────
%% ESTILOS
%% ─────────────────────────────────────────
    classDef security  fill:#ff6b6b,color:#fff,stroke:#c0392b,stroke-width:2px
    classDef gateway   fill:#3498db,color:#fff,stroke:#2980b9,stroke-width:2px
    classDef service   fill:#2ecc71,color:#fff,stroke:#27ae60,stroke-width:2px
    classDef broker    fill:#f39c12,color:#fff,stroke:#e67e22,stroke-width:2px
    classDef repo      fill:#9b59b6,color:#fff,stroke:#8e44ad,stroke-width:2px
    classDef db        fill:#e74c3c,color:#fff,stroke:#c0392b,stroke-width:2px
    classDef pattern   fill:#1abc9c,color:#fff,stroke:#16a085,stroke-width:2px,stroke-dasharray:5 5
    classDef client    fill:#ecf0f1,color:#2c3e50,stroke:#bdc3c7,stroke-width:2px

    class User,Frontend client
    class WAF,Auth security
    class GW gateway
    class OrdersSvc,InvSvc,ShipSvc service
    class E1,E2,E3 broker
    class RepO,RepI,RepS repo
    class DBO,DBI,DBS db
    class CB,FM pattern
